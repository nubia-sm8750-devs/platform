## configs for NX789J project
#CONFIG_*=m

#add for nubia board id
CONFIG_NUBIA_HW_CONFIG_BY_GPIO=y
CONFIG_NUBIA_HW_VERSION=m
#CONFIG_NUBIA_BOARD_ID=y

#vib
CONFIG_AWINIC_HAPTIC_HV=m

#LED
CONFIG_NUBIA_LED_AW22XXX=y

#slide key
CONFIG_NUBIA_KEYBOARD_GPIOKEYS=m

#nfc
CONFIG_NFC_ST54J=y
CONFIG_NFC_ST54J_ESE=m
CONFIG_NFC_GPIO35_CLKREQ=y

#ir
CONFIG_ZTE_IR=m

#nubia_fan
CONFIG_SOC_FAN=m

#nubia dp
CONFIG_NUBIA_DP=y
#Add for charger skin thermal distinguish
CONFIG_ZTE_FEATURE_CHG_BATT_2S=y

#tp
CONFIG_TOUCHSCREEN_BOARD_NAME="aston"
CONFIG_TOUCHSCREEN_GOODIX_BRL_THP=y
CONFIG_TOUCHSCREEN_DRM_PANEL_NOTIFIER=y
CONFIG_TOUCHSCREEN_UFP_MAC=y

#Audio Smartpa AWINIC
CONFIG_SND_SMARTPA_AW882XX=y
