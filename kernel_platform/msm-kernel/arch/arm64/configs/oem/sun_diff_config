##config for sm8750 platform
#ADD:CONFIG_*

CONFIG_ZTE_BOOT_CODE=y
#--------------------------
# vendor soc driver
#--------------------------
CONFIG_VENDOR_SOC_QCOM_SRC=y
CONFIG_VENDOR_IMEM_INFO=m
CONFIG_VENDOR_KERNEL_MODULE_PARAM=m
#charger
CONFIG_POWER_VENDOR_COMMON=y
CONFIG_VENDOR_ZTE_MISC=m
CONFIG_VENDOR_CHARGER_POLICY_SERVICE=m
CONFIG_ZTE_POWER_SUPPLY=m
CONFIG_VENDOR_PMLOG=m
CONFIG_VENDOR_PMLOG_PLATFORM=8550

#--------------------------
# vendor common driver
#--------------------------
CONFIG_VENDOR_COMMON_COMPILE=y

#zte log reset reason from K68
CONFIG_VENDOR_ZLOG_RESET_REASON=m
CONFIG_VENDOR_RAMDISK_ZLOG_REASON=m
CONFIG_VENDOR_PANIC_SIMULATION=y

#stats info for iotop
CONFIG_VENDOR_STATS_INFO=m

# sensor
CONFIG_NUBIA_SENSORS_SENS_EN=m

CONFIG_QCOM_WATCHDOG_BARK_TIME=15000
CONFIG_VENDOR_ZTE_IFAS_INNER=m

#nubia usb
CONFIG_NUBIA_USB=y
